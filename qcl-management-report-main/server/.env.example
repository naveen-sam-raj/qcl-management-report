# ===================================================
# SPIC / TFL / GREENSTAR ANALYTICS - ENVIRONMENT TEMPLATE
# ===================================================

PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas / Local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/spic_analytics_db?retryWrites=true&w=majority

# JWT Authentication Config
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Initial Super Admin Configuration (for QCL_ADMIN default setup)
INITIAL_SUPER_ADMIN_PASSWORD=Admin@QCL2026!

# Microsoft 365 / Microsoft Graph API Email Configuration
MICROSOFT_TENANT_ID=your-azure-tenant-id
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_SENDER_EMAIL=reports@spic.co.in
CLIENT_URL=http://localhost:5173

# Nodemailer SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM="ACL Plant Management" <no-reply@spic.co.in>
